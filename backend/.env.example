# PostgreSQL connection; replace the placeholders locally and never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, for example a provider's HTTPS API base URL.
LLM_BASE_URL=

# Local API settings; pass these values to Uvicorn when starting the server.
HOST=127.0.0.1
PORT=8000
